# URL base da API consumida pelos helpers de src/api
VITE_API_URL=http://localhost:6767

# ─── Permissões: bitmap estilo chmod ─────────────────────────────────────────
#
#   bit | valor | permissão
#   ----+-------+--------------------------
#    4  |   16  | users  (gerir usuários)
#    3  |    8  | create
#    2  |    4  | update
#    1  |    2  | delete
#    0  |    1  | read
#
# A máscara do papel é a soma dos valores:
#
#   papel  | users | create | update | delete | read | máscara | leitura
#   -------+-------+--------+--------+--------+------+---------+--------
#   admin  |   16  |    8   |    4   |    2   |   1  |    31   | Ucudr
#   owner  |   16  |    8   |    4   |    2   |   1  |    31   | Ucudr
#   editor |    -  |    8   |    4   |    2   |   1  |    15   | -cudr
#   viewer |    -  |    -   |    -   |    -   |   1  |     1   | ----r
#
# Os valores abaixo são os padrões do código — só declare para sobrescrever.
# VITE_ROLE_ADMIN=31
# VITE_ROLE_OWNER=31
# VITE_ROLE_EDITOR=15
# VITE_ROLE_VIEWER=1

# Papel assumido quando a sessão não traz um papel conhecido (padrão: viewer)
# VITE_DEFAULT_ROLE=viewer

# Porta do dev server (padrão 3000)
PORT=3000
