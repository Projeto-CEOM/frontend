# URL base da API consumida pelos helpers de src/api
VITE_API_URL=http://localhost:6767

# Mock por recurso. O padrão de cada um acompanha o que o backend já expõe:
#   salas    -> API real  (/api/rooms/ existe)
#   sensores -> mock      (/api/sensors/ ainda retorna 404)
#   login    -> mock      (/api/auth/login ainda retorna 404)
# Descomente com true/false para forçar o comportamento.
# VITE_USE_MOCK_ROOMS=true
# VITE_USE_MOCK_SENSORS=false
# VITE_USE_MOCK_AUTH=false

# Override geral (vale para os três, quando os flags acima não estão definidos)
# VITE_USE_MOCK_API=true

# Porta do dev server (padrão 3000)
PORT=3000
